generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Status { ACTIVE INACTIVE
}
enum UserStatus { ACTIVE INACTIVE LOCKED
}
enum PurchaseStatus { DRAFT PENDING APPROVED RECEIVED PARTIALLY_RECEIVED COMPLETED CANCELLED
}
enum SaleStatus { DRAFT COMPLETED PARTIAL_RETURN RETURNED CANCELLED
}
enum PaymentStatus { UNPAID PARTIAL PAID REFUNDED
}
enum PaymentType { CASH CARD BANK_TRANSFER E_WALLET OTHER
}
enum MovementType { PURCHASE SALE SALE_RETURN PURCHASE_RETURN ADJUSTMENT TRANSFER_IN TRANSFER_OUT INITIAL_STOCK
}
enum PromotionType { PERCENTAGE FIXED
}
enum AccountType { ASSET LIABILITY EQUITY REVENUE EXPENSE
}
enum ExpenseStatus { DRAFT APPROVED VOID
}

model Store {
  id String @id @default(cuid())
  code String @unique @db.VarChar(30)
  name String @db.VarChar(120)
  address String? @db.Text
  phone String? @db.VarChar(30)
  email String? @db.VarChar(190)
  status Status @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  warehouses Warehouse[]
  users User[]
  sales Sale[]
  purchases Purchase[]
  expenses Expense[]
  @@index([name])
}

model Warehouse {
  id String @id @default(cuid())
  code String @db.VarChar(30)
  name String @db.VarChar(120)
  address String? @db.Text
  status Status @default(ACTIVE)
  storeId String
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  inventory Inventory[]
  movements StockMovement[]
  purchases Purchase[]
  sales Sale[]
  @@unique([storeId, code])
  @@index([storeId, name])
}

model User {
  id String @id @default(cuid())
  name String @db.VarChar(120)
  username String @unique @db.VarChar(60)
  email String? @unique @db.VarChar(190)
  passwordHash String @db.VarChar(255)
  phone String? @db.VarChar(30)
  status UserStatus @default(ACTIVE)
  storeId String?
  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)
  roles UserRole[]
  sales Sale[]
  auditLogs AuditLog[]
  expenses Expense[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
}

model Role {
  id String @id @default(cuid())
  name String @unique @db.VarChar(60)
  description String? @db.VarChar(255)
  users UserRole[]
  permissions RolePermission[]
}

model Permission {
  id String @id @default(cuid())
  key String @unique @db.VarChar(100)
  description String? @db.VarChar(255)
  roles RolePermission[]
}

model UserRole {
  userId String
  roleId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model RolePermission {
  roleId String
  permissionId String
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
}

model Category {
  id String @id @default(cuid())
  name String @unique @db.VarChar(100)
  description String? @db.Text
  status Status @default(ACTIVE)
  products Product[]
  promotions Promotion[]
}

model Brand {
  id String @id @default(cuid())
  name String @unique @db.VarChar(100)
  status Status @default(ACTIVE)
  products Product[]
}

model Unit {
  id String @id @default(cuid())
  name String @unique @db.VarChar(60)
  symbol String @unique @db.VarChar(15)
  products Product[]
}

model Product {
  id String @id @default(cuid())
  sku String @unique @db.VarChar(60)
  barcode String? @unique @db.VarChar(100)
  name String @db.VarChar(180)
  description String? @db.Text
  costPrice Decimal @default(0) @db.Decimal(15, 2)
  sellingPrice Decimal @db.Decimal(15, 2)
  minimumStock Decimal @default(0) @db.Decimal(15, 3)
  maximumStock Decimal? @db.Decimal(15, 3)
  taxRate Decimal @default(0) @db.Decimal(6, 3)
  imageUrl String? @db.VarChar(500)
  status Status @default(ACTIVE)
  categoryId String?
  brandId String?
  unitId String
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  brand Brand? @relation(fields: [brandId], references: [id], onDelete: SetNull)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  inventory Inventory[]
  movements StockMovement[]
  purchaseItems PurchaseItem[]
  saleItems SaleItem[]
  promotionProducts PromotionProduct[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@index([categoryId])
}

model ProductVariant {
  id String @id @default(cuid())
  productId String
  name String @db.VarChar(100)
  sku String @unique @db.VarChar(60)
  barcode String? @unique @db.VarChar(100)
  attributes Json?
}

model Inventory {
  id String @id @default(cuid())
  productId String
  warehouseId String
  quantity Decimal @default(0) @db.Decimal(15, 3)
  reservedQuantity Decimal @default(0) @db.Decimal(15, 3)
  averageCost Decimal @default(0) @db.Decimal(15, 2)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  updatedAt DateTime @updatedAt
  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

model StockMovement {
  id String @id @default(cuid())
  type MovementType
  quantity Decimal @db.Decimal(15, 3)
  unitCost Decimal? @db.Decimal(15, 2)
  referenceType String? @db.VarChar(40)
  referenceId String? @db.VarChar(100)
  notes String? @db.Text
  productId String
  warehouseId String
  createdById String?
  createdAt DateTime @default(now())
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  @@index([productId, warehouseId, createdAt])
  @@index([referenceType, referenceId])
}

model StockAdjustment { id String @id @default(cuid())
  number String @unique @db.VarChar(40)
  warehouseId String
  reason String @db.VarChar(255)
  createdById String
  createdAt DateTime @default(now())
}
model StockTransfer { id String @id @default(cuid())
  number String @unique @db.VarChar(40)
  fromWarehouseId String
  toWarehouseId String
  status String @default("COMPLETED") @db.VarChar(20)
  createdById String
  createdAt DateTime @default(now())
}

model Customer {
  id String @id @default(cuid())
  customerCode String @unique @db.VarChar(40)
  name String @db.VarChar(150)
  email String? @db.VarChar(190)
  phone String? @db.VarChar(30)
  address String? @db.Text
  gender String? @db.VarChar(20)
  dateOfBirth DateTime?
  status Status @default(ACTIVE)
  loyaltyPoints Int @default(0)
  sales Sale[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
  @@index([phone])
}

model Supplier {
  id String @id @default(cuid())
  supplierCode String @unique @db.VarChar(40)
  name String @db.VarChar(150)
  contactPerson String? @db.VarChar(120)
  email String? @db.VarChar(190)
  phone String? @db.VarChar(30)
  address String? @db.Text
  taxNumber String? @db.VarChar(60)
  status Status @default(ACTIVE)
  purchases Purchase[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([name])
}

model Purchase {
  id String @id @default(cuid())
  invoiceNumber String @unique @db.VarChar(60)
  status PurchaseStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)
  purchaseDate DateTime @default(now())
  subtotal Decimal @db.Decimal(15, 2)
  discount Decimal @default(0) @db.Decimal(15, 2)
  tax Decimal @default(0) @db.Decimal(15, 2)
  shipping Decimal @default(0) @db.Decimal(15, 2)
  grandTotal Decimal @db.Decimal(15, 2)
  notes String? @db.Text
  supplierId String
  storeId String
  warehouseId String
  supplier Supplier @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  items PurchaseItem[]
  payments PurchasePayment[]
  createdAt DateTime @default(now())
  @@index([purchaseDate, storeId])
}

model PurchaseItem { id String @id @default(cuid())
  purchaseId String
  productId String
  quantity Decimal @db.Decimal(15, 3)
  receivedQuantity Decimal @default(0) @db.Decimal(15, 3)
  unitCost Decimal @db.Decimal(15, 2)
  discount Decimal @default(0) @db.Decimal(15, 2)
  tax Decimal @default(0) @db.Decimal(15, 2)
  subtotal Decimal @db.Decimal(15, 2)
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}
model PurchasePayment { id String @id @default(cuid())
  purchaseId String
  method PaymentType
  amount Decimal @db.Decimal(15, 2)
  reference String? @db.VarChar(120)
  paidAt DateTime @default(now())
  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model Sale {
  id String @id @default(cuid())
  invoiceNumber String @unique @db.VarChar(60)
  status SaleStatus @default(DRAFT)
  paymentStatus PaymentStatus @default(UNPAID)
  saleDate DateTime @default(now())
  subtotal Decimal @db.Decimal(15, 2)
  discount Decimal @default(0) @db.Decimal(15, 2)
  tax Decimal @default(0) @db.Decimal(15, 2)
  grandTotal Decimal @db.Decimal(15, 2)
  amountPaid Decimal @default(0) @db.Decimal(15, 2)
  change Decimal @default(0) @db.Decimal(15, 2)
  customerId String?
  storeId String
  warehouseId String
  cashierId String
  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  cashier User @relation(fields: [cashierId], references: [id], onDelete: Restrict)
  items SaleItem[]
  payments SalePayment[]
  returns SaleReturn[]
  createdAt DateTime @default(now())
  @@index([saleDate, storeId])
  @@index([cashierId])
}
model SaleItem { id String @id @default(cuid())
  saleId String
  productId String
  quantity Decimal @db.Decimal(15, 3)
  unitPrice Decimal @db.Decimal(15, 2)
  unitCost Decimal @db.Decimal(15, 2)
  discount Decimal @default(0) @db.Decimal(15, 2)
  tax Decimal @default(0) @db.Decimal(15, 2)
  subtotal Decimal @db.Decimal(15, 2)
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
}
model SalePayment { id String @id @default(cuid())
  saleId String
  method PaymentType
  amount Decimal @db.Decimal(15, 2)
  reference String? @db.VarChar(120)
  paidAt DateTime @default(now())
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade)
}
model SaleReturn { id String @id @default(cuid())
  number String @unique @db.VarChar(50)
  saleId String
  reason String @db.Text
  amount Decimal @db.Decimal(15, 2)
  createdAt DateTime @default(now())
  sale Sale @relation(fields: [saleId], references: [id], onDelete: Restrict)
  items SaleReturnItem[]
}
model SaleReturnItem { id String @id @default(cuid())
  returnId String
  saleItemId String
  quantity Decimal @db.Decimal(15, 3)
  amount Decimal @db.Decimal(15, 2)
  return SaleReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
}

model PaymentMethod { id String @id @default(cuid())
  type PaymentType @unique
  name String @db.VarChar(50)
  active Boolean @default(true)
}
model Promotion { id String @id @default(cuid())
  name String @db.VarChar(120)
  type PromotionType
  value Decimal @db.Decimal(15, 2)
  minimumPurchase Decimal @default(0) @db.Decimal(15, 2)
  startsAt DateTime
  endsAt DateTime
  active Boolean @default(true)
  categoryId String?
  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  products PromotionProduct[]
}
model PromotionProduct { promotionId String
  productId String
  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  @@id([promotionId, productId])
}

model ExpenseCategory { id String @id @default(cuid())
  name String @unique @db.VarChar(100)
  expenses Expense[]
}
model Expense { id String @id @default(cuid())
  number String @unique @db.VarChar(40)
  amount Decimal @db.Decimal(15, 2)
  expenseDate DateTime @default(now())
  description String? @db.Text
  paymentMethod PaymentType
  status ExpenseStatus @default(DRAFT)
  categoryId String
  storeId String
  createdById String
  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  store Store @relation(fields: [storeId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
}
model Account { id String @id @default(cuid())
  code String @unique @db.VarChar(30)
  name String @db.VarChar(120)
  type AccountType
  active Boolean @default(true)
  entries JournalEntry[]
}
model Journal { id String @id @default(cuid())
  number String @unique @db.VarChar(50)
  journalDate DateTime @default(now())
  description String? @db.Text
  sourceType String? @db.VarChar(40)
  sourceId String? @db.VarChar(100)
  entries JournalEntry[]
  createdAt DateTime @default(now())
}
model JournalEntry { id String @id @default(cuid())
  journalId String
  accountId String
  debit Decimal @default(0) @db.Decimal(15, 2)
  credit Decimal @default(0) @db.Decimal(15, 2)
  journal Journal @relation(fields: [journalId], references: [id], onDelete: Cascade)
  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)
}

model Setting { key String @id @db.VarChar(100)
  value Json
  updatedAt DateTime @updatedAt
}
model AuditLog { id String @id @default(cuid())
  userId String?
  action String @db.VarChar(60)
  module String @db.VarChar(60)
  entity String? @db.VarChar(80)
  entityId String? @db.VarChar(100)
  oldValue Json?
  newValue Json?
  ip String? @db.VarChar(45)
  userAgent String? @db.VarChar(500)
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([module, createdAt])
  @@index([entity, entityId])
}
